dockerfile "Dockerfile"

# API_BASE_URL is read by the .weave sources. It assumes the backend in
# ../backend was initialised as `heighliner init manabe`; change it if yours
# differs.
app_params "
  -e API_BASE_URL=https://manabe.<%= http_suffix %>/api/v1
"

expose "4567"

# `heighliner up -a` / `attach` only: the project is mounted over the copy in
# the image, so weaver renders the files as they are on disk and a browser
# refresh shows an edit, with no rebuild. Without -a the container keeps the
# copy from its last build.
attach_mount '.', '/app'

type :http
